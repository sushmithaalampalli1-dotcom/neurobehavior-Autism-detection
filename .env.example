# ==========================================
# NeuroBehavior-ASD Environment Configuration
# Copy this file to .env and adjust variables
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL
# ==========================================

# Flask Environment
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1

# Security
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Database (SQLite default for initial milestone)
DATABASE_URL=sqlite:///neurobehavior_asd.db

# CORS Configuration (Frontend URL)
FRONTEND_ORIGIN=http://localhost:5173

# MRI & Data Directories
UPLOAD_FOLDER=uploads/mri
MAX_CONTENT_LENGTH_MB=250

# Model Configuration
MODEL_PATH=training/saved_models/neurobehavior_25d_cnn.keras
MODEL_MODE=trained  # options: standby, evaluation, trained
